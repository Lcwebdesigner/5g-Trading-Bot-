# Copy to /etc/5g-bot.env on the server (chmod 600). Never commit this file or send it to anyone.
DERIV_APP_ID=
PUBLIC_BASE_URL=https://bot.yourdomain.com
BOT_DATA_DIR=/opt/5g/data
BOT_TZ=Africa/Nairobi
# Optional safety knobs (defaults shown):
# ALLOW_REAL=1              set to 0 to switch real-money trading off for everybody
# REAL_MAX_STAKE=5.00
# REAL_MAX_DAILY_LOSS=10.00
# DEMO_MAX_STAKE=100.00
# MAX_USERS=20

